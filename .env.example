# Where the server listens. Use 0.0.0.0:8080 inside Docker or on a server.
BIND_ADDR=127.0.0.1:8080

# Comma-separated origins allowed to use the WebSocket and HTTP API.
# Must match the frontend's URL exactly (scheme, host and port). `*` = any (dev only).
ALLOWED_ORIGINS=http://localhost:3000

# Sockets allowed per room. The frontend limits calls to 2 people itself.
MAX_ROOM_SIZE=10

STUN_URLS=stun:stun.l.google.com:19302

# TURN relay (coturn). Set both or neither. TURN_SECRET must equal coturn's
# static-auth-secret. Generate one with: openssl rand -hex 32
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349
# TURN_SECRET=
# TURN_TTL_SECS=86400

RUST_LOG=video_call_backend=debug,tower_http=info
